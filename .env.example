# Record assistant (api/routes/ai.py). Copy to .env in the repo root and fill in the key.
# .env is git-ignored. The key stays on the station server: the browser never receives it.
# Without a key the app still works: every assistant button shows an answer built from the
# same facts by fixed rules.

# gemini | deepseek | openai (any OpenAI-compatible server, with AI_BASE_URL)
AI_PROVIDER=gemini
AI_API_KEY=

# Leave empty for the provider default: gemini-3.5-flash-lite, deepseek-flash.
AI_MODEL=

# Optional.
# AI_BASE_URL=https://example.com/v1     # only for AI_PROVIDER=openai
# AI_TIMEOUT_S=4                         # the UI shows the rule-based answer after this
# AI_REASONING_EFFORT=minimal            # empty value = do not send the parameter
# AI_CACHE_PATH=/data/ai_cache.json      # answers are cached so a rehearsed demo replays offline
